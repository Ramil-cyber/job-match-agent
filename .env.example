# Copy this file to .env and replace placeholders only for local development.
OPENAI_API_KEY=your_openai_api_key_here

# Keep the public live feature off until authentication and quotas are ready.
ENABLE_PUBLIC_OPENAI_ANALYSIS=false
PUBLIC_ANALYSIS_USER_LIMIT=3
PUBLIC_ANALYSIS_DAILY_LIMIT=10
PUBLIC_ANALYSIS_TOTAL_LIMIT=100
PUBLIC_MAX_RESUME_CHARACTERS=8000
PUBLIC_MAX_JOB_CHARACTERS=8000
PUBLIC_MAX_OUTPUT_TOKENS=3000

# Dedicated Supabase quota project. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
USER_HASH_SALT=replace_with_a_long_random_secret
